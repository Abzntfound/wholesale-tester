# Environment — copy values into js/env.js (frontend public config only)
# NEVER commit service-role keys, payment secrets, or database passwords.

# Supabase (safe for frontend — anon key only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Product data source: local | supabase | remote
DATA_SOURCE=local

# Enable after payment edge functions are deployed
PAYMENT_ENABLED=false

# Supabase Edge Function secrets (set via: supabase secrets set KEY=value)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=...  (edge functions only — NEVER in frontend)
# PAYMENT_PROVIDER=stripe
# SITE_URL=https://www.wholesaleclearance.co.uk
# ALLOWED_ORIGINS=http://localhost:3000,https://www.wholesaleclearance.co.uk
